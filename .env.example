# Vikram Sarabhai Digital Twin — Environment Configuration
# Copy this file to .env and fill in your values

# === API Keys ===
GEMINI_API_KEYS=your_api_key_1,your_api_key_2,your_api_key_3
# GOOGLE_API_KEY is handled by api_rotator.py dynamically
# === Database Paths ===
CHROMA_DB_PATH=./chroma_db
SQLITE_DB_PATH=./memory.db

# === Application Settings ===
APP_MODE=development
APP_HOST=0.0.0.0
APP_PORT=8000
GRADIO_PORT=7860

# === Corpus Settings ===
CORPUS_DIR=./data/corpus
PROCESSED_DIR=./data/processed

# === Model Settings ===
EMBEDDING_MODEL=gemini-embedding-2
GEMINI_MODEL=gemini-2.5-flash

# === RAG Settings ===
CHUNK_SIZE=512
CHUNK_OVERLAP=50
RAG_TOP_K=5

# === Memory Settings ===
MEMORY_CONFIDENCE_THRESHOLD=0.75

# === LangChain (disable optional tracing) ===
LANGCHAIN_TRACING_V2=false
